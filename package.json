{
  "name": "edugraph-learning",
  "version": "1.1.1",
  "description": "EduGraph AI 学习模式 · DSH 插件：资料解析（含电路图渲染）、知识图谱、学习计划、练习批改与间隔复习",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "learning",
    "education",
    "knowledge-graph",
    "fsrs",
    "spaced-repetition"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/server.test.mjs test/parse.test.mjs test/fsrs.test.mjs test/search.test.mjs",
    "test:server": "node --test test/server.test.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "canvas": "^3.2.3",
    "pdfjs-dist": "^4.8.69"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}